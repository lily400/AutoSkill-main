{
  "version": 1,
  "split": "development",
  "purpose": "Regression fixtures targeting observed failures; not a held-out benchmark or executed score",
  "cases": [
    {
      "id": "example",
      "input": "order_id,customer_id,updated_at,amount\n001,C2,2026-01-01T08:00:00+08:00,10.00\n001,C1,2026-01-01T00:00:00Z,12.50\n002,,2026-01-02T00:00:00Z,\n003,C1,2026-01-03T00:00:00Z,2.25\n",
      "expect": "success",
      "outputs": {
        "deduplicated.csv": "order_id,customer_id,updated_at,amount\n001,C1,2026-01-01T00:00:00Z,12.50\n002,UNKNOWN,2026-01-02T00:00:00Z,0.00\n003,C1,2026-01-03T00:00:00Z,2.25\n",
        "summary.csv": "customer_id,order_count,total_amount,latest_updated_at\nC1,2,14.75,2026-01-03T00:00:00Z\nUNKNOWN,1,0.00,2026-01-02T00:00:00Z\n"
      }
    },
    {
      "id": "offset_0830",
      "input": "order_id,customer_id,updated_at,amount\n001,C1,2026-01-01T08:30:00+08:30,1\n",
