      "expect": "success",
      "outputs": {
        "deduplicated.csv": "order_id,customer_id,updated_at,amount\na,C1,2026-01-01T00:00:00Z,123456789012345678901234567890.12\nb,C1,2026-01-01T00:00:00Z,0.01\n",
        "summary.csv": "customer_id,order_count,total_amount,latest_updated_at\nC1,2,123456789012345678901234567890.13,2026-01-01T00:00:00Z\n"
