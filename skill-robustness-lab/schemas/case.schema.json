{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "case",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "4.0"
      ]
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "case_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "split": {
      "enum": [
        "development",
        "validation",
        "heldout_test"
      ]
    },
    "usage": {
      "enum": [
        "development_only",
        "research"
      ]
    },
    "source_record": {
      "type": "string",
      "minLength": 1
    },
    "source_file": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contract_file": {
      "type": "string",
      "minLength": 1
    },
    "task_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "variant_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "official": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "domain_type": {
          "type": "string",
          "minLength": 1
        },
        "family_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "domain",
        "domain_type",
        "family_name"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "case_key",
    "version",
    "title",
    "status",
    "source_id",
    "source_version",
    "family_id",
    "split",
    "usage",
    "source_record",
    "source_file",
    "source_sha256",
    "contract_file",
    "task_files",
    "variant_files",
    "official"
  ],
  "additionalProperties": false
}
