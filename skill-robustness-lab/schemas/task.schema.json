{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "4.0"
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "family_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "split": {
      "enum": [
        "development",
        "validation",
        "heldout_test"
      ]
    },
    "purpose": {
      "enum": [
        "development",
        "validation",
        "heldout_test"
      ]
    },
    "contract_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "judge_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "expected": {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": [
            "success",
            "error"
          ]
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "error_record": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "error_field": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "outcome",
        "outputs",
        "error_record",
        "error_field"
      ],
      "additionalProperties": false
    },
    "covered_rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "minItems": 0
    },
    "coverage_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "case_id",
    "source_id",
    "family_id",
    "split",
    "purpose",
    "contract_id",
    "judge_id",
    "prompt",
    "inputs",
    "expected",
    "covered_rule_ids",
    "coverage_note"
  ],
  "additionalProperties": false
}
