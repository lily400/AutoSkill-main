{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "program_ir",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "4.0"
      ]
    },
    "ir_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "variant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "ir_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "not_run",
        "generated",
        "invalid",
        "validated"
      ]
    },
    "goal": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "minItems": 0
          },
          "kind": {
            "enum": [
              "action",
              "for_each"
            ]
          }
        },
        "required": [
          "step_id",
          "action",
          "depends_on",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "then_step_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "minItems": 0
          },
          "else_step_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "minItems": 0
          }
        },
        "required": [
          "condition",
          "then_step_ids",
          "else_step_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "provenance_file": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "validation_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "ir_id",
    "case_id",
    "source_id",
    "variant_id",
    "run_id",
    "ir_version",
    "status",
    "goal",
    "inputs",
    "preconditions",
    "steps",
    "branches",
    "invariants",
    "outputs",
    "checks",
    "unresolved",
    "provenance_file",
    "validation_reason"
  ],
  "additionalProperties": false
}
