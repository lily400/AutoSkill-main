{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "4.0"
      ]
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "origin": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "locally_authored",
            "repository",
            "publication",
            "web",
            "other"
          ]
        },
        "uri": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "license": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "unknown_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "uri",
        "revision",
        "license",
        "unknown_reason"
      ],
      "additionalProperties": false
    },
    "document_file": {
      "type": "string",
      "minLength": 1
    },
    "document_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "source_id",
    "source_version",
    "family_id",
    "origin",
    "document_file",
    "document_sha256",
    "description"
  ],
  "additionalProperties": false
}
