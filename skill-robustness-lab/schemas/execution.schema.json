{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "execution",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "4.0"
      ]
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "family_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "judge_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "enum": [
        "generated_skill",
        "reference",
        "no_skill"
      ]
    },
    "execution_repeat": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "not_run",
        "running",
        "completed",
        "failed",
        "blocked"
      ]
    },
    "failure_category": {
      "enum": [
        "none",
        "infrastructure",
        "generation",
        "execution",
        "unknown"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "executor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "version",
        "model"
      ],
      "additionalProperties": false
    },
    "input_before": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "input_after": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "actual_outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "record": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "field": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "record",
            "field",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "finished_at_utc": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "dataset_freeze_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_checksums_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "standard_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "required": [
    "schema_version",
    "execution_id",
    "case_id",
    "source_id",
    "family_id",
    "task_id",
    "contract_id",
    "judge_id",
    "run_id",
    "mode",
    "execution_repeat",
    "status",
    "failure_category",
    "reason",
    "executor",
    "input_before",
    "input_after",
    "actual_outputs",
    "error",
    "exit_code",
    "started_at_utc",
    "finished_at_utc",
    "dataset_freeze_sha256",
    "run_checksums_sha256",
    "standard_hashes"
  ],
  "additionalProperties": false
}
