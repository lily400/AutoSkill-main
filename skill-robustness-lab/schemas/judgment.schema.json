{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "judgment",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "4.0"
      ]
    },
    "judgment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "judge_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "not_run"
      ]
    },
    "passed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "passed",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "execution_checksums_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "judge_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "judgment_id",
    "execution_id",
    "case_id",
    "task_id",
    "judge_id",
    "status",
    "passed",
    "checks",
    "reason",
    "execution_checksums_sha256",
    "judge_sha256",
    "created_at_utc"
  ],
  "additionalProperties": false
}
