{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "4.0"
      ]
    },
    "contract_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "source_text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "rule_id",
          "source_text"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "review_status": {
      "enum": [
        "pending",
        "reviewed"
      ]
    },
    "review_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "contract_id",
    "case_id",
    "version",
    "source_id",
    "source_version",
    "source_sha256",
    "rules",
    "review_status",
    "review_note"
  ],
  "additionalProperties": false
}
