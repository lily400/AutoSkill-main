{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "degradation",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "4.0"
      ]
    },
    "degradation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "variant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "generator": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "file",
        "sha256",
        "version"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "object"
    },
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "before",
          "after"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "recoverability": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "recoverable",
            "irrecoverable",
            "conflicting"
          ]
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "reviewer",
        "evidence",
        "rule_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "degradation_id",
    "case_id",
    "variant_id",
    "type",
    "severity",
    "seed",
    "generator",
    "parameters",
    "edits",
    "recoverability"
  ],
  "additionalProperties": false
}
