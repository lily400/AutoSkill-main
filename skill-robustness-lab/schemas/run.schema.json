{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "run",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "4.0"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "split": {
      "enum": [
        "development",
        "validation",
        "heldout_test"
      ]
    },
    "variant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "method_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "generation_repeat": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "preflight",
        "generation"
      ]
    },
    "status": {
      "enum": [
        "preflight",
        "preflight_only",
        "running",
        "completed_unreviewed",
        "failed",
        "timeout",
        "interrupted",
        "artifact_validation_failed",
        "framework_changed"
      ]
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset_freeze_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "comparison_fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "structural_pass": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "semantic_status": {
      "enum": [
        "pending",
        "not_applicable"
      ]
    },
    "execution_status": {
      "enum": [
        "not_run"
      ]
    },
    "failure": {
      "type": "object",
      "properties": {
        "category": {
          "enum": [
            "infrastructure",
            "generation",
            "evidence",
            "interrupted",
            "unknown",
            "none"
          ]
        },
        "stage": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "category",
        "stage",
        "evidence"
      ],
      "additionalProperties": false
    },
    "program_ir_status": {
      "enum": [
        "not_applicable",
        "not_run"
      ]
    },
    "started_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "finished_at_utc": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "source_id",
    "source_version",
    "family_id",
    "split",
    "variant_id",
    "method_id",
    "generation_repeat",
    "kind",
    "status",
    "input_sha256",
    "dataset_freeze_sha256",
    "comparison_fingerprint",
    "structural_pass",
    "semantic_status",
    "execution_status",
    "failure",
    "program_ir_status",
    "started_at_utc",
    "finished_at_utc"
  ],
  "additionalProperties": false
}
