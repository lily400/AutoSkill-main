{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "variant",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "4.0"
      ]
    },
    "variant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "condition": {
      "enum": [
        "clean",
        "degraded"
      ]
    },
    "input_file": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "clean_variant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "clean_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "degradation_file": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "frozen"
      ]
    }
  },
  "required": [
    "schema_version",
    "variant_id",
    "version",
    "case_id",
    "source_id",
    "source_version",
    "family_id",
    "condition",
    "input_file",
    "input_sha256",
    "clean_variant_id",
    "clean_sha256",
    "contract_id",
    "degradation_file",
    "status"
  ],
  "additionalProperties": false
}
