{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "split",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "4.0"
      ]
    },
    "split_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "family_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "split": {
            "enum": [
              "development",
              "validation",
              "heldout_test"
            ]
          }
        },
        "required": [
          "case_id",
          "source_id",
          "family_id",
          "split"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "heldout_locked": {
      "type": "boolean"
    },
    "formal_ready": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "split_id",
    "version",
    "status",
    "policy",
    "assignments",
    "heldout_locked",
    "formal_ready",
    "reason"
  ],
  "additionalProperties": false
}
