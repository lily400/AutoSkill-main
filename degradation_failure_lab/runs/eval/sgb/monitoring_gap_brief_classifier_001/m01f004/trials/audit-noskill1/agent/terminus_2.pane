[?2004l[?2004h> NO_SYSTEMATIC = "NO_SYSTEMATIC_MONITORING"
[?2004l[?2004h> NEEDS_IMPROVED = "NEEDS_IMPROVED_MONITORING"
[?2004l[?2004h> SYSTEMATIC = "SYSTEMATIC_MONITORING_PRESENT"
