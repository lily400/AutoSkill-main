[?2004l[?2004h>     mode = request.get("mode", "short")
[?2004l[?2004h>     include_actions = bool(request.get("include_actions", False))
[?2004l[?2004h>     include_challenges = bool(request.get("include_challenges", False))
[?2004l[?2004h> 
[?2004l[?2004h>     briefs = []
