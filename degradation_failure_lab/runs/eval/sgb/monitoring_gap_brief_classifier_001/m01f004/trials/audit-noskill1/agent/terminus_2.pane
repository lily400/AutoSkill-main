[?2004l[?2004h> 
[?2004l[?2004h> ACTION_ORDER = {
[?2004l[?2004h>     NO_SYSTEMATIC: ["WORKGROUP", "STD_PROTOCOLS", "PARTNERSHIPS", "ECOSYS_MON"],
[?2004l[?2004h>     NEEDS_IMPROVED: ["STD_PROTOCOLS", "ECOSYS_MON", "WORKGROUP", "PARTNERSHIPS"],
[?2004l[?2004h>     SYSTEMATIC: ["STD_PROTOCOLS", "ECOSYS_MON", "WORKGROUP"],
[?2004l[?2004h>     NOT_SPECIFIED: ["WORKGROUP", "STD_PROTOCOLS"],
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> CHALLENGES = [
[?2004l[?2004h>     "INADEQUATE_FUNDS",
[?2004l[?2004h>     "LACK_TRAINED_PERSONNEL",
[?2004l[?2004h>     "INSUFFICIENT_TOOLS_PROTOCOLS",
[?2004l[?2004h>     "POOR_DATA_MANAGEMENT",
[?2004l[?2004h>     "INFO_SHARING_GAPS",
[?2004l[?2004h>     "RARE_FLUCTUATING_TRADEOFFS",
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> # Hardcoded canonical labels derived from Chapter 8 when available.
[?2004l[?2004h> # The container does not include the excerpt, so this table intentionally
[?2004l[?2004h> # remains conservative and can be extended if the excerpt is supplied.
[?2004l[?2004h> NAME_TO_CLASS = {
[?2004l[?2004h>     # Example placeholders for exact matching if the excerpted canonical labels are known.
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _classify_name(name: str) -> str:
