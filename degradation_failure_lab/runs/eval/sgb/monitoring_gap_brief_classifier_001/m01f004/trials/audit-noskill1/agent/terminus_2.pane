[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _guardrail(claimed_status: Any) -> str:
[?2004l[?2004h>     if not isinstance(claimed_status, str) or not claimed_status.strip():
[?2004l[?2004h>         return "OK"
[?2004l[?2004h>     s = claimed_status.lower()
[?2004l[?2004h>     if re.search(r"\b(will\s+go\s+extinct|certain\s+extinction|go\s+extinct|extinct\b)", s):
[?2004l[?2004h>         return "BLOCK"
[?2004l[?2004h>     if re.search(r"\b(within\s+\d+\s+(?:years?|months?|days?)|by\s+\d{4}|by\s+20\d{2})\b", s):
[?2004l[?2004h>         return "BLOCK"
[?2004l[?2004h>     if re.search(r"\b[a-z]+\s+[a-z]+\b", s) and any(tok in s for tok in ["extinct", "extinction", "will"])):
[?2004l[?2004h>         return "BLOCK"
[?2004l[?2004h>     return "OK"
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _actions_for(monitoring_class: str, mode: str) -> List[str]:
[?2004l[?2004h>     limit = 2 if mode == "short" else 4
[?2004l[?2004h>     ordered = ACTION_ORDER.get(monitoring_class, ["WORKGROUP", "STD_PROTOCOLS"])
[?2004l[?2004h>     return ordered[:limit]
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def solve(input_data: Dict[str, Any]) -> Dict[str, Any]:
[?2004l[?2004h>     items = input_data.get("items", []) or []
