[?2004l[?2004h> 
[?2004l[?2004h> def _signal_allows(from_node: str, edge_id: str, tick: int) -> bool:
[?2004l[?2004h>     # Best-effort fixed-cycle model for Morning Rush N3/N4.
[?2004l[?2004h>     # If no known signalized downstream node, allow entry.
[?2004l[?2004h>     # Assumption: edges entering N3/N4 are controlled by 8-tick cycles with a 4-tick green per movement.
[?2004l[?2004h>     # N3: phase 0 green for incoming edge groups A, phase 1 green for others alternating by even/odd tick blocks.
[?2004l[?2004h>     # N4: similar alternating fixed cycle.
[?2004l[?2004h>     # Without explicit map data, conservatively allow all non-N3/N4 signals.
[?2004l[?2004h>     if from_node not in {'N3', 'N4'}:
[?2004l[?2004h>         return True
[?2004l[?2004h>     cycle = 8
[?2004l[?2004h>     phase = (tick // 4) % 2
[?2004l[?2004h>     # Treat odd/even 4-tick windows as green for incoming traffic.
[?2004l[?2004h>     return phase in (0, 1)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def solve(input_data):
[?2004l[?2004h>     tick = input_data.get('tick', 0)
[?2004l[?2004h>     edge_occupancy = input_data.get('edge_occupancy', {}) or {}
[?2004l[?2004h>     enter_requests = input_data.get('enter_requests', []) or []
[?2004l[?2004h>     active_incidents = input_data.get('active_incidents', []) or []
[?2004l[?2004h> 
[?2004l[?2004h>     decisions = []
[?2004l[?2004h>     for req in enter_requests:
[?2004l[?2004h>         vehicle_id = req.get('vehicle_id')
[?2004l[?2004h>         edge_id = req.get('edge_id')
[?2004l[?2004h>         from_node = req.get('from_node')
[?2004l[?2004h>         occupancy_before = len(edge_occupancy.get(edge_id, []))
[?2004l[?2004h> 
[?2004l[?2004h>         baseline_capacity = 1
[?2004l[?2004h>         relevant = _active_incidents(edge_id, tick, active_incidents)
[?2004l[?2004h>         closure = any(inc.get('effect_type') == 'CLOSE_EDGE' for inc in relevant)
[?2004l[?2004h>         multiplier = 1.0
[?2004l[?2004h>         for inc in relevant:
[?2004l[?2004h>             if inc.get('effect_type') == 'REDUCE_CAPACITY':
[?2004l[?2004h>                 try:
[?2004l[?2004h>                     m = float(inc.get('capacity_multiplier', 1.0))
[?2004l[?2004h>                 except Exception:
[?2004l[?2004h>                     m = 1.0
[?2004l[?2004h>                 multiplier = min(multiplier, m)
[?2004l[?2004h> 
[?2004l[?2004h>         effective_max = baseline_capacity
[?2004l[?2004h>         if not closure:
[?2004l[?2004h>             effective_max = int(floor(baseline_capacity * multiplier))
[?2004l[?2004h>             if effective_max < 0:
[?2004l[?2004h>                 effective_max = 0
[?2004l[?2004h> 
[?2004l[?2004h>         signal_ok = _signal_allows(from_node, edge_id, tick)
[?2004l[?2004h>         approved = (not closure) and signal_ok and (occupancy_before < effective_max)
[?2004l[?2004h> 
[?2004l[?2004h>         if closure:
[?2004l[?2004h>             reason = 'CLOSURE'
[?2004l[?2004h>         elif not signal_ok:
[?2004l[?2004h>             reason = 'SIGNAL'
[?2004l[?2004h>         elif occupancy_before >= effective_max:
[?2004l[?2004h>             reason = 'CAPACITY'
[?2004l[?2004h>         else:
[?2004l[?2004h>             reason = 'APPROVED'
[?2004l[?2004h> 
[?2004l[?2004h>         decisions.append({
[?2004l[?2004h>             'vehicle_id': vehicle_id,
[?2004l[?2004h>             'edge_id': edge_id,
[?2004l[?2004h>             'approved': approved,
[?2004l[?2004h>             'action': 'ENTER_EDGE' if approved else 'WAIT',
[?2004l[?2004h>             'reason': reason,
[?2004l[?2004h>             'effective_max_vehicles': effective_max,
[?2004l[?2004h>             'occupancy_before': occupancy_before,
[?2004l[?2004h>         })
