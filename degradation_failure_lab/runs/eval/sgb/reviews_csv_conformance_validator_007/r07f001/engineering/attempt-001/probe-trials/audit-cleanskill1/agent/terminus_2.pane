# 按品牌文本的 Nike/竞品二分归类
[?2004hp1$ python -c "from pathlib import Path; print(Path('/harbor/skills/5705f35c-9afe-5668-81aa-6ae7e5d4f172/SKILL.md').read_text()[356:635],end='')"
