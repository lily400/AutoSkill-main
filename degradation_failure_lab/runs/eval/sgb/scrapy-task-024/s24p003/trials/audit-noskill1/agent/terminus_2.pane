[?2004l[?2004hp1$ cat > /workspace/agent_output.py <<'PY'
[?2004l[?2004h> """Scrapy feed export default overwrite behavior.
[?2004l[?2004h> 
[?2004l[?2004h> Supported built-in feed storage backends:
[?2004l[?2004h> - Local filesystem (`file:///tmp/export.json` or absolute paths like `/tmp/export.json`): overwrite enabled by default.
[?2004l[?2004h> - FTP (`ftp://server/export.json`): overwrite disabled by default.
[?2004l[?2004h> - Amazon S3 (`s3://bucket/export.json`): overwrite disabled by default.
[?2004l[?2004h> - Google Cloud Storage (`gs://bucket/export.json`): overwrite disabled by default.
[?2004l[?2004h> - Stdout (`stdout:`): overwrite enabled by default.
[?2004l[?2004h> 
[?2004l[?2004h> Unsupported schemes raise ValueError.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> from urllib.parse import urlparse
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def default_feed_overwrite(uri: str) -> bool:
[?2004l[?2004h>     """Return Scrapy's built-in default feed overwrite setting for *uri*."""
[?2004l[?2004h> 
[?2004l[?2004h>     if not isinstance(uri, str) or not uri:
[?2004l[?2004h>         raise ValueError("feed URI must be a non-empty string")
[?2004l[?2004h> 
[?2004l[?2004h>     # Absolute local paths are treated as local filesystem feed URIs.
[?2004l[?2004h>     if uri.startswith("/"):
[?2004l[?2004h>         return True
[?2004l[?2004h> 
[?2004l[?2004h>     parsed = urlparse(uri)
[?2004l[?2004h>     scheme = parsed.scheme.lower()
[?2004l[?2004h> 
[?2004l[?2004h>     if scheme == "file":
[?2004l[?2004h>         return True
[?2004l[?2004h>     if scheme == "stdout":
[?2004l[?2004h>         return True
[?2004l[?2004h>     if scheme in {"ftp", "s3", "gs"}:
[?2004l[?2004h>         return False
[?2004l[?2004h> 
[?2004l[?2004h>     raise ValueError(f"unsupported feed URI scheme: {scheme or uri!r}")
[?2004l[?2004h> PY
