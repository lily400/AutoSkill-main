[?2004l[?2004h> """Scrapy feed export overwrite defaults.
[?2004l[?2004h> 
[?2004l[?2004h> Supported built-in backends:
[?2004l[?2004h> - file and absolute local paths: overwrite by default
[?2004l[?2004h> - ftp: overwrite by default
[?2004l[?2004h> - s3: do not overwrite by default
[?2004l[?2004h> - gs: do not overwrite by default
[?2004l[?2004h> - stdout: do not overwrite by default
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> from urllib.parse import urlparse
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def default_feed_overwrite(uri: str) -> bool:
[?2004l[?2004h>     """Return Scrapy's built-in default overwrite behavior for a feed URI."""
[?2004l[?2004h>     if not isinstance(uri, str) or not uri:
[?2004l[?2004h>         raise ValueError("uri must be a non-empty string")
[?2004l[?2004h> 
[?2004l[?2004h>     # Treat absolute local paths as filesystem destinations.
[?2004l[?2004h>     if uri.startswith("/"):
[?2004l[?2004h>         return True
[?2004l[?2004h> 
[?2004l[?2004h>     parsed = urlparse(uri)
[?2004l[?2004h>     scheme = parsed.scheme
[?2004l[?2004h> 
[?2004l[?2004h>     if scheme == "file":
[?2004l[?2004h>         return True
[?2004l[?2004h>     if scheme == "ftp":
[?2004l[?2004h>         return True
[?2004l[?2004h>     if scheme == "s3":
[?2004l[?2004h>         return False
[?2004l[?2004h>     if scheme == "gs":
[?2004l[?2004h>         return False
[?2004l[?2004h>     if scheme == "stdout":
[?2004l[?2004h>         return False
[?2004l[?2004h> 
[?2004l[?2004h>     raise ValueError(f"unsupported feed URI scheme: {scheme or uri!r}")
