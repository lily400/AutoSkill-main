[?2004hp1$ cat > /workspace/agent_output.py <<'PY'
[?2004l[?2004h> """Scrapy feed export overwrite defaults by backend.
[?2004l[?2004h> 
[?2004l[?2004h> Supported built-in backends:
[?2004l[?2004h> - Local filesystem (``file:///tmp/export.json`` or absolute paths like ``/tmp/export.json``): overwrite defaults to True.
[?2004l[?2004h> - FTP (``ftp://server/export.json``): overwrite defaults to False.
[?2004l[?2004h> - S3 (``s3://bucket/export.json``): overwrite defaults to False.
[?2004l[?2004h> - GCS (``gs://bucket/export.json``): overwrite defaults to False.
[?2004l[?2004h> - Standard output (``stdout:``): overwrite defaults to True.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> from urllib.parse import urlparse
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def default_feed_overwrite(uri: str) -> bool:
[?2004l[?2004h>     """Return Scrapy's default overwrite behavior for a feed URI.
[?2004l[?2004h> 
[?2004l[?2004h>     Parameters
[?2004l[?2004h>     ----------
[?2004l[?2004h>     uri:
[?2004l[?2004h>         Feed URI or absolute local filesystem path.
[?2004l[?2004h> 
[?2004l[?2004h>     Returns
[?2004l[?2004h>     -------
[?2004l[?2004h>     bool
[?2004l[?2004h>         The default value Scrapy uses for the ``overwrite`` option for the
[?2004l[?2004h>         corresponding built-in feed storage backend.
[?2004l[?2004h> 
[?2004l[?2004h>     Raises
[?2004l[?2004h>     ------
[?2004l[?2004h>     ValueError
[?2004l[?2004h>         If the URI scheme is unsupported.
[?2004l[?2004h>     """
[?2004l[?2004h> 
[?2004l[?2004h>     if uri.startswith("/"):
[?2004l[?2004h>         return True
[?2004l[?2004h> 
[?2004l[?2004h>     parsed = urlparse(uri)
[?2004l[?2004h>     scheme = parsed.scheme.lower()
[?2004l[?2004h> 
[?2004l[?2004h>     if scheme == "file":
[?2004l[?2004h>         return True
[?2004l[?2004h>     if scheme == "ftp":
[?2004l[?2004h>         return False
[?2004l[?2004h>     if scheme == "s3":
[?2004l[?2004h>         return False
[?2004l[?2004h>     if scheme == "gs":
[?2004l[?2004h>         return False
[?2004l[?2004h>     if scheme == "stdout":
[?2004l[?2004h>         return True
[?2004l[?2004h> 
[?2004l[?2004h>     raise ValueError(f"Unsupported feed URI scheme: {scheme or uri!r}")
[?2004l[?2004h> PY
