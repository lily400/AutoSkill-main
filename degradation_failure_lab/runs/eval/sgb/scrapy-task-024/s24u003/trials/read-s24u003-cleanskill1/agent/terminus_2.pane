[?2004l[?2004h> """Resolve Scrapy feed export default overwrite behavior.
[?2004l[?2004h> 
[?2004l[?2004h> Supported built-in backends:
[?2004l[?2004h> - local filesystem (file:///tmp/export.json or /tmp/export.json): overwrite=False
[?2004l[?2004h> - FTP (ftp://server/export.json): overwrite=True
[?2004l[?2004h> - S3 (s3://bucket/export.json): overwrite=True
[?2004l[?2004h> - GCS (gs://bucket/export.json): overwrite=True
[?2004l[?2004h> - stdout (stdout:): overwrite=False
[?2004l[?2004h> 
[?2004l[?2004h> Unsupported schemes raise ValueError.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> from urllib.parse import urlparse
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def default_feed_overwrite(uri: str) -> bool:
[?2004l[?2004h>     """Return Scrapy's default overwrite behavior for a feed URI."""
[?2004l[?2004h>     if not isinstance(uri, str):
[?2004l[?2004h>         raise TypeError("uri must be a string")
[?2004l[?2004h> 
[?2004l[?2004h>     if uri == "stdout:" or uri == "stdout":
[?2004l[?2004h>         return False
[?2004l[?2004h> 
[?2004l[?2004h>     # Absolute filesystem paths are treated as local file backend.
[?2004l[?2004h>     if uri.startswith("/"):
[?2004l[?2004h>         return False
[?2004l[?2004h> 
[?2004l[?2004h>     parsed = urlparse(uri)
[?2004l[?2004h>     scheme = parsed.scheme
[?2004l[?2004h> 
[?2004l[?2004h>     if scheme == "file":
[?2004l[?2004h>         return False
[?2004l[?2004h>     if scheme in {"ftp", "s3", "gs"}:
[?2004l[?2004h>         return True
[?2004l[?2004h> 
[?2004l[?2004h>     raise ValueError(f"Unsupported feed URI scheme: {scheme or 'none'}")
[?2004l[?2004h> PY
