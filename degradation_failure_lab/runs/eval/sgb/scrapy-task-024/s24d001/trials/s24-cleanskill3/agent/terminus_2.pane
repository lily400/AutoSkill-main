[?2004l[?2004hp1$ cat > /workspace/agent_output.py <<'PY'
[?2004l[?2004h> """Resolve Scrapy feed export default overwrite behavior for built-in storages.
[?2004l[?2004h> 
[?2004l[?2004h> Supported backends:
[?2004l[?2004h> - Local filesystem (absolute paths and file:// URIs): default overwrite is False.
[?2004l[?2004h> - FTP (ftp://): default overwrite is True.
[?2004l[?2004h> - Amazon S3 (s3://): default overwrite is True.
[?2004l[?2004h> - Google Cloud Storage (gs://): default overwrite is True.
[?2004l[?2004h> - Standard output (stdout:): default overwrite is True.
[?2004l[?2004h> 
[?2004l[?2004h> Unsupported schemes raise ValueError.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> from urllib.parse import urlparse
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def default_feed_overwrite(uri: str) -> bool:
[?2004l[?2004h>     """Return Scrapy's built-in default overwrite value for a feed URI."""
[?2004l[?2004h>     if uri == "stdout:" or uri.startswith("stdout:"):
[?2004l[?2004h>         return True
[?2004l[?2004h> 
[?2004l[?2004h>     parsed = urlparse(uri)
[?2004l[?2004h> 
[?2004l[?2004h>     if parsed.scheme in ("", "file"):
[?2004l[?2004h>         return False
[?2004l[?2004h>     if parsed.scheme in {"ftp", "s3", "gs"}:
[?2004l[?2004h>         return True
[?2004l[?2004h> 
[?2004l[?2004h>     raise ValueError(f"Unsupported feed URI scheme: {parsed.scheme or 'local'}")
[?2004l[?2004h> PY
[?2004l[?2004hp1$ python3 - <<'PY'
[?2004l[?2004h> from agent_output import default_feed_overwrite
[?2004l[?2004h> cases = {
[?2004l[?2004h>     'file:///tmp/export.json': False,
[?2004l[?2004h>     '/tmp/export.json': False,
[?2004l[?2004h>     'ftp://server/export.json': True,
[?2004l[?2004h>     's3://bucket/export.json': True,
[?2004l[?2004h>     'gs://bucket/export.json': True,
[?2004l[?2004h>     'stdout:': True,
[?2004l[?2004h> }
[?2004l[?2004h> for uri, expected in cases.items():
[?2004l[?2004h>     got = default_feed_overwrite(uri)
[?2004l[?2004h>     print(uri, got, expected, 'OK' if got == expected else 'BAD')
