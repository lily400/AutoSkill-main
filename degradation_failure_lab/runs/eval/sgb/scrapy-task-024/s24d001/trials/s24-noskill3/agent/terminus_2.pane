[?2004hp1$ cat > /workspace/agent_output.py <<'PY'
[?2004l[?2004h> """Resolve Scrapy feed export default overwrite behavior for built-in storages.
[?2004l[?2004h> 
[?2004l[?2004h> Supported backends:
[?2004l[?2004h> - Local filesystem (absolute paths and file:/// URIs): overwrite by default.
[?2004l[?2004h> - FTP: do not overwrite by default.
[?2004l[?2004h> - S3: do not overwrite by default.
[?2004l[?2004h> - GCS/GS: do not overwrite by default.
[?2004l[?2004h> - stdout: do not overwrite by default.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> from urllib.parse import urlsplit
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def default_feed_overwrite(uri: str) -> bool:
[?2004l[?2004h>     """Return Scrapy's default feed overwrite behavior for a feed URI.
[?2004l[?2004h> 
[?2004l[?2004h>     Raises:
[?2004l[?2004h>         ValueError: If the URI scheme is unsupported.
[?2004l[?2004h>     """
[?2004l[?2004h>     if not isinstance(uri, str) or not uri:
[?2004l[?2004h>         raise ValueError("Unsupported feed URI")
[?2004l[?2004h> 
[?2004l[?2004h>     # Absolute local filesystem paths are treated as local file feed URIs.
[?2004l[?2004h>     if uri.startswith("/"):
[?2004l[?2004h>         return True
[?2004l[?2004h> 
[?2004l[?2004h>     parsed = urlsplit(uri)
[?2004l[?2004h>     scheme = parsed.scheme.lower()
[?2004l[?2004h> 
[?2004l[?2004h>     if scheme == "file":
[?2004l[?2004h>         return True
[?2004l[?2004h>     if scheme in {"ftp", "s3", "gs", "stdout"}:
[?2004l[?2004h>         return False
[?2004l[?2004h> 
[?2004l[?2004h>     raise ValueError(f"Unsupported feed URI scheme: {scheme or uri}")
[?2004l[?2004h> PY
[?2004l[?2004hp1$ cd /workspace && python3 - <<'PY'
[?2004l[?2004h> from agent_output import default_feed_overwrite
[?2004l[?2004h> 
[?2004l[?2004h> cases = {
