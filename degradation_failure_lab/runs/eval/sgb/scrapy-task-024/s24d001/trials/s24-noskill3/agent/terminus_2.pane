[?2004l[?2004h>     '/tmp/export.json': True,
[?2004l[?2004h>     'ftp://server/export.json': False,
[?2004l[?2004h>     's3://bucket/export.json': False,
[?2004l[?2004h>     'gs://bucket/export.json': False,
[?2004l[?2004h>     'stdout:': False,
[?2004l[?2004h> }
[?2004l[?2004h> for uri, expected in cases.items():
