[?2004l[?2004h> """Scrapy feed export default overwrite behavior.
[?2004l[?2004h> 
[?2004l[?2004h> Supported backends:
[?2004l[?2004h> - file:///... and absolute local paths: overwrite by default.
[?2004l[?2004h> - ftp://...: do not overwrite by default.
[?2004l[?2004h> - s3://...: do not overwrite by default.
[?2004l[?2004h> - gs://...: do not overwrite by default.
[?2004l[?2004h> - stdout:: do not overwrite by default.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> from urllib.parse import urlparse
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def default_feed_overwrite(uri: str) -> bool:
[?2004l[?2004h>     """Return Scrapy's built-in default overwrite behavior for a feed URI."""
[?2004l[?2004h>     if not isinstance(uri, str) or not uri:
[?2004l[?2004h>         raise ValueError("Unsupported feed URI")
[?2004l[?2004h> 
[?2004l[?2004h>     # Absolute local path without scheme is treated as a file backend.
[?2004l[?2004h>     if uri.startswith("/"):
[?2004l[?2004h>         return True
[?2004l[?2004h> 
[?2004l[?2004h>     if uri == "stdout:" or uri == "stdout":
[?2004l[?2004h>         return False
[?2004l[?2004h> 
[?2004l[?2004h>     parsed = urlparse(uri)
[?2004l[?2004h>     scheme = parsed.scheme
[?2004l[?2004h> 
[?2004l[?2004h>     if scheme == "file":
[?2004l[?2004h>         return True
[?2004l[?2004h>     if scheme in {"ftp", "s3", "gs"}:
[?2004l[?2004h>         return False
[?2004l[?2004h> 
[?2004l[?2004h>     raise ValueError(f"Unsupported feed URI scheme: {scheme or uri}")
[?2004l[?2004h> PY
[?2004l[?2004hp1$ python3 -m py_compile /workspace/agent_output.py
[?2004l[?2004hp1$ cd /workspace && python3 - <<'PY'
[?2004l[?2004h> from agent_output import default_feed_overwrite
[?2004l[?2004h> cases = {
[?2004l[?2004h>     'file:///tmp/export.json': True,
[?2004l[?2004h>     '/tmp/export.json': True,
[?2004l[?2004h>     'ftp://server/export.json': False,
[?2004l[?2004h>     's3://bucket/export.json': False,
[?2004l[?2004h>     'gs://bucket/export.json': False,
[?2004l[?2004h>     'stdout:': False,
[?2004l[?2004h> }
[?2004l[?2004h> for uri, expected in cases.items():
[?2004l[?2004h>     got = default_feed_overwrite(uri)
[?2004l[?2004h>     print(uri, got, 'OK' if got == expected else f'EXPECTED {expected}')
[?2004l[?2004h> for uri in ['http://x', 'https://x', 'ftps://x', 'stderr:']:
[?2004l[?2004h>     try:
