  {
    "window_id": "9303d8cc-95bb-5f13-b00a-50c0f4284b8a",
    "source_id": "sgb-scrapy024-feed-exports",
    "input_sha256": "a3831d75f00d59a0527a469dc26af5dcf741294e25572c46bb587b28f7e2165d",
    "official_span": {
      "start": 11437,
      "end": 13083
    },
    "exact_line_matches": [
      {
        "input_line": 297,
        "text": "Accepted `feed_options` parameters:"
      },
      {
        "input_line": 299,
        "text": "- gzip_compresslevel"
      },
      {
        "input_line": 300,
        "text": "- gzip_mtime"
      },
      {
        "input_line": 301,
        "text": "- gzip_filename"
      },
      {
        "input_line": 303,
        "text": "See [`gzip.GzipFile`](https://docs.python.org/3/library/gzip.html#gzip.GzipFile) for more info about parameters."
      },
      {
        "input_line": 307,
        "text": "Compresses received data using [lzma](https://en.wikipedia.org/wiki/Lempel–Ziv–Markov_chain_algorithm)."
      },
      {
        "input_line": 309,
        "text": "Accepted `feed_options` parameters:"
      },
      {
        "input_line": 311,
        "text": "- lzma_format"
      },
      {
        "input_line": 312,
        "text": "- lzma_check"
      },
      {
        "input_line": 313,
        "text": "- lzma_preset"
      },
      {
        "input_line": 314,
        "text": "- lzma_filters"
      },
      {
        "input_line": 316,
        "text": "`lzma_filters` cannot be used in pypy version 7.3.1 and older."
      },
      {
        "input_line": 318,
        "text": "See [`lzma.LZMAFile`](https://docs.python.org/3/library/lzma.html#lzma.LZMAFile) for more info about parameters."
      },
      {
        "input_line": 322,
        "text": "Compresses received data using [bz2](https://en.wikipedia.org/wiki/Bzip2)."
      },
      {
        "input_line": 324,
        "text": "Accepted `feed_options` parameters:"
      },
      {
        "input_line": 326,
        "text": "- bz2_compresslevel"
      },
      {
        "input_line": 328,
        "text": "See [`bz2.BZ2File`](https://docs.python.org/3/library/bz2.html#bz2.BZ2File) for more info about parameters."
      }
    ],
    "unmatched_normalized_lines": [],
    "coordinate_note": "Input-file line matches; upstream spans address normalized text. Degraded positions are not original-source positions."
  },
  {
    "window_id": "3e20e6ef-4842-5ff8-b5f5-147ab4784752",
    "source_id": "sgb-scrapy024-feed-exports",
    "input_sha256": "a3831d75f00d59a0527a469dc26af5dcf741294e25572c46bb587b28f7e2165d",
    "official_span": {
      "start": 13237,
      "end": 13480
    },
    "exact_line_matches": [
      {
        "input_line": 259,
        "text": "**Parameters:**"
      },
      {
        "input_line": 340,
        "text": "- **file** – file-like object having at least the write, tell and close methods implemented"
      },
      {
        "input_line": 341,
        "text": "- **feed_options** ([`dict`](https://docs.python.org/3/library/stdtypes.html#dict)) – feed-specific options"
      },
      {
        "input_line": 343,
        "text": "**write(*self*, *data*)**"
      }
    ],
    "unmatched_normalized_lines": [],
    "coordinate_note": "Input-file line matches; upstream spans address normalized text. Degraded positions are not original-source positions."
  },
  {
    "window_id": "38e332c8-87db-5888-a25e-50a5157e8111",
    "source_id": "sgb-scrapy024-feed-exports",
    "input_sha256": "a3831d75f00d59a0527a469dc26af5dcf741294e25572c46bb587b28f7e2165d",
    "official_span": {
      "start": 14101,
      "end": 14429
    },
    "exact_line_matches": [
      {
        "input_line": 363,
        "text": "These are the settings used for configuring the feed exports:"
      },
      {
        "input_line": 365,
        "text": "- `FEEDS` (mandatory)"
      },
      {
        "input_line": 366,
        "text": "- `FEED_EXPORT_ENCODING`"
      },
      {
        "input_line": 367,
        "text": "- `FEED_STORE_EMPTY`"
      },
      {
        "input_line": 368,
        "text": "- `FEED_EXPORT_FIELDS`"
      },
      {
        "input_line": 369,
        "text": "- `FEED_EXPORT_INDENT`"
      },
      {
        "input_line": 370,
        "text": "- `FEED_STORAGES`"
      },
      {
        "input_line": 371,
        "text": "- `FEED_STORAGE_FTP_ACTIVE`"
      },
      {
        "input_line": 372,
        "text": "- `FEED_STORAGE_S3_ACL`"
      },
      {
        "input_line": 373,
        "text": "- `FEED_EXPORTERS`"
      },
      {
        "input_line": 374,
        "text": "- `FEED_EXPORT_BATCH_ITEM_COUNT`"
      },
      {
        "input_line": 378,
        "text": "Default: `{}`"
      }
    ],
    "unmatched_normalized_lines": [
      "Settings",
      "FEEDS"
    ],
    "coordinate_note": "Input-file line matches; upstream spans address normalized text. Degraded positions are not original-source positions."
  },
  {
    "window_id": "0739a552-345a-5261-935a-421eafcc78eb",
    "source_id": "sgb-scrapy024-feed-exports",
    "input_sha256": "a3831d75f00d59a0527a469dc26af5dcf741294e25572c46bb587b28f7e2165d",
    "official_span": {
      "start": 15603,
      "end": 17155
    },
    "exact_line_matches": [
      {
        "input_line": 420,
        "text": "The following is a list of the accepted keys and the setting that is used"
      },
      {
        "input_line": 421,
        "text": "as a fallback value if that key is not provided for a specific feed definition:"
      },
      {
        "input_line": 423,
        "text": "- `format`: the serialization format."
      },
      {
        "input_line": 425,
        "text": "This setting is mandatory, there is no fallback value."
      },
      {
        "input_line": 426,
        "text": "- `batch_item_count`: falls back to"
      },
      {
        "input_line": 427,
        "text": "`FEED_EXPORT_BATCH_ITEM_COUNT`."
      },
      {
        "input_line": 428,
        "text": "- `encoding`: falls back to `FEED_EXPORT_ENCODING`."
      },
      {
        "input_line": 429,
        "text": "- `fields`: falls back to `FEED_EXPORT_FIELDS`."
      },
      {
        "input_line": 430,
        "text": "- `item_classes`: list of [item classes](items.html#topics-items) to export."
      },
      {
        "input_line": 432,
        "text": "If undefined or empty, all items are exported."
      },
      {
        "input_line": 433,
        "text": "- `item_filter`: a filter class to filter items to export."
      },
      {
        "input_line": 435,
        "text": "`ItemFilter` is used be default."
      },
      {
        "input_line": 436,
        "text": "- `indent`: falls back to `FEED_EXPORT_INDENT`."
      },
      {
        "input_line": 437,
        "text": "- `item_export_kwargs`: [`dict`](https://docs.python.org/3/library/stdtypes.html#dict) with keyword arguments for the corresponding [item exporter class](exporters.html#topics-exporters)."
      },
      {
        "input_line": 438,
        "text": "- `overwrite`: whether to overwrite the file if it already exists"
      },
      {
        "input_line": 439,
        "text": "(`True`) or append to its content (`False`)."
      },
      {
        "input_line": 441,
        "text": "The default value depends on the storage backend:"
      },
      {
        "input_line": 442,
        "text": "  - Local filesystem: `False`"
      },
      {
        "input_line": 443,
        "text": "  - FTP: `True`"
      },
      {
        "input_line": 445,
        "text": "Some FTP servers may not support appending to files (the"
      },
      {
        "input_line": 446,
        "text": "`APPE` FTP command)."
      },
      {
        "input_line": 447,
        "text": "  - S3: `True` (appending is not supported)"
      },
      {
        "input_line": 448,
        "text": "  - Google Cloud Storage (GCS): `True` (appending is not supported)"
      },
      {
        "input_line": 449,
        "text": "  - Standard output: `False` (overwriting is not supported)"
      },
      {
        "input_line": 450,
        "text": "- `store_empty`: falls back to `FEED_STORE_EMPTY`."
      },
      {
        "input_line": 451,
        "text": "- `uri_params`: falls back to `FEED_URI_PARAMS`."
      },
      {
        "input_line": 452,
        "text": "- `postprocessing`: list of plugins to use for post-processing."
      },
      {
        "input_line": 454,
        "text": "The plugins will be used in the order of the list passed."
      }
    ],
    "unmatched_normalized_lines": [],
    "coordinate_note": "Input-file line matches; upstream spans address normalized text. Degraded positions are not original-source positions."
  },
  {
    "window_id": "233720cb-0832-536a-ae8f-77a9901ae699",
    "source_id": "sgb-scrapy024-feed-exports",
    "input_sha256": "a3831d75f00d59a0527a469dc26af5dcf741294e25572c46bb587b28f7e2165d",
    "official_span": {
      "start": 21442,
      "end": 22112
    },
    "exact_line_matches": [
      {
        "input_line": 590,
        "text": "When generating multiple output files, you must use at least one of the following"
      },
      {
        "input_line": 591,
        "text": "placeholders in the feed URI to indicate how the different output file names are"
      },
      {
        "input_line": 592,
        "text": "generated:"
      },
      {
        "input_line": 594,
        "text": "- `%(batch_time)s` - gets replaced by a timestamp when the feed is being created"
      },
      {
        "input_line": 595,
        "text": "(e.g. `2020-03-28T14-45-08.237134`)"
      },
      {
        "input_line": 596,
        "text": "- `%(batch_id)d` - gets replaced by the 1-based sequence number of the batch."
      },
      {
        "input_line": 598,
        "text": "Use [printf-style string formatting](https://docs.python.org/3/library/stdtypes.html#old-string-formatting) to"
      },
      {
        "input_line": 599,
        "text": "alter the number format. For example, to make the batch ID a 5-digit"
      },
      {
        "input_line": 600,
        "text": "number by introducing leading zeroes as needed, use `%(batch_id)05d`"
      },
      {
        "input_line": 601,
        "text": "(e.g. `3` becomes `00003`, `123` becomes `00123`)."
      }
    ],
    "unmatched_normalized_lines": [],
    "coordinate_note": "Input-file line matches; upstream spans address normalized text. Degraded positions are not original-source positions."
  },
  {
    "window_id": "ca1dface-ec8b-51df-9db6-ddf012c0b4d7",
    "source_id": "sgb-scrapy024-feed-exports",
    "input_sha256": "a3831d75f00d59a0527a469dc26af5dcf741294e25572c46bb587b28f7e2165d",
    "official_span": {
      "start": 23265,
      "end": 23913
    },
    "exact_line_matches": [
      {
        "input_line": 259,
        "text": "**Parameters:**"
      },
      {
        "input_line": 645,
        "text": "- **params** ([*dict*](https://docs.python.org/3/library/stdtypes.html#dict)) –"
      },
      {
        "input_line": 647,
        "text": "default key-value pairs"
      },
      {
        "input_line": 649,
        "text": "Specifically:"
      },
      {
        "input_line": 650,
        "text": "  - `batch_id`: ID of the file batch. See"
      },
      {
        "input_line": 651,
        "text": "`FEED_EXPORT_BATCH_ITEM_COUNT`."
      },
      {
        "input_line": 653,
        "text": "If `FEED_EXPORT_BATCH_ITEM_COUNT` is `0`, `batch_id`"
      },
      {
        "input_line": 654,
        "text": "is always `1`."
      },
      {
        "input_line": 655,
        "text": "  - `batch_time`: UTC date and time, in ISO format with `:`"
      },
      {
        "input_line": 656,
        "text": "replaced with `-`."
      },
      {
        "input_line": 658,
        "text": "See `FEED_EXPORT_BATCH_ITEM_COUNT`."
      },
      {
        "input_line": 659,
        "text": "  - `time`: `batch_time`, with microseconds set to `0`."
      },
      {
        "input_line": 660,
        "text": "- **spider** ([*scrapy.Spider*](spiders.html#scrapy.Spider)) – source spider of the feed items"
      },
      {
        "input_line": 662,
        "text": "The function should return a new dictionary, modifying"
      },
      {
        "input_line": 663,
        "text": "the received `params` in-place is deprecated."
      }
    ],
    "unmatched_normalized_lines": [],
    "coordinate_note": "Input-file line matches; upstream spans address normalized text. Degraded positions are not original-source positions."
  },
  {
    "window_id": "26298b77-ed09-5689-a4ab-b3d4333ff176",
    "source_id": "sgb-scrapy024-feed-exports",
    "input_sha256": "a3831d75f00d59a0527a469dc26af5dcf741294e25572c46bb587b28f7e2165d",
    "official_span": {
      "start": 23915,
      "end": 24443
    },
    "exact_line_matches": [
      {
        "input_line": 665,
        "text": "For example, to include the [`name`](spiders.html#scrapy.Spider.name) of the"
      },
      {
        "input_line": 666,
        "text": "source spider in the feed URI:"
      },
      {
        "input_line": 668,
        "text": "1. Define the following function somewhere in your project:"
      },
      {
        "input_line": 670,
        "text": "```"
      },
      {
        "input_line": 671,
        "text": "# myproject/utils.py"
      },
      {
        "input_line": 672,
        "text": "def uri_params(params, spider):"
      },
      {
        "input_line": 673,
        "text": "    return {**params, \"spider_name\": spider.name}"
      },
      {
        "input_line": 674,
        "text": "```"
      },
      {
        "input_line": 675,
        "text": "2. Point `FEED_URI_PARAMS` to that function in your settings:"
      },
      {
        "input_line": 677,
        "text": "```"
      },
      {
        "input_line": 678,
        "text": "# myproject/settings.py"
      },
      {
        "input_line": 679,
        "text": "FEED_URI_PARAMS = \"myproject.utils.uri_params\""
      },
      {
        "input_line": 680,
        "text": "```"
      },
      {
        "input_line": 681,
        "text": "3. Use `%(spider_name)s` in your feed URI:"
      },
      {
        "input_line": 683,
        "text": "```"
      },
      {
        "input_line": 684,
        "text": "scrapy crawl <spider_name> -o \"%(spider_name)s.jsonl\""
      },
      {
        "input_line": 685,
        "text": "```"
      }
    ],
    "unmatched_normalized_lines": [],
    "coordinate_note": "Input-file line matches; upstream spans address normalized text. Degraded positions are not original-source positions."
  }
]
