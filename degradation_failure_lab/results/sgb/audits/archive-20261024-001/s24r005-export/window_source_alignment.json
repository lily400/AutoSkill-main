    },
    "exact_line_matches": [
      {
        "input_line": 178,
        "text": "The feeds are stored on [Google Cloud Storage](https://cloud.google.com/storage/)."
      },
      {
        "input_line": 180,
        "text": "- URI scheme: `gs`"
      },
      {
        "input_line": 181,
        "text": "- Example URIs:"
