nd, expected at least {MIN_ROWS}')\n        out['details']['row_count'] = len(data_rows)\n        return out\n\n    # Success\n    return {\n        'ok': True,\n        'message': f'SUCCESS: Processed reviews CSV validated ({len(data_rows)} rows).',\n        'details': {\n            'row_count': len(data_rows),\n            'missing_columns': [],\n            'invalid_values': []\n        }\n    }\n",
