        "input_line": 39,
        "text": "> 4. Add-on settings"
      },
      {
        "input_line": 40,
        "text": "> 5. Command-specific default settings"
      },
      {
        "input_line": 41,
        "text": "> 6. Global default settings (lowest precedence)"
      },
      {
        "input_line": 45,
        "text": "Settings set in the command line have the highest precedence, overriding any"
      },
      {
        "input_line": 46,
        "text": "other settings."
      },
      {
        "input_line": 48,
        "text": "You can explicitly override one or more settings using the `-s` (or"
      },
      {
        "input_line": 49,
        "text": "`--set`) command-line option."
      }
    ],
    "unmatched_normalized_lines": [
