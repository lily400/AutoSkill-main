    "exact_line_matches": [
      {
        "input_line": 124,
        "text": "Designating the settings"
      },
      {
        "input_line": 128,
        "text": "[Add-ons](addons.html#topics-addons) can modify settings. They should do this with"
      },
      {
        "input_line": 129,
        "text": "`\"addon\"` priority where possible."
      },
