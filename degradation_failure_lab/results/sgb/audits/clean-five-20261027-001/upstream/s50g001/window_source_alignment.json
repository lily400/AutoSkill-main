        "input_line": 14,
        "text": "See documentation in docs/topics/spider-middleware.rst"
      },
      {
        "input_line": 15,
        "text": "\"\"\""
      },
      {
        "input_line": 17,
        "text": "from __future__ import annotations"
      },
      {
        "input_line": 19,
        "text": "import logging"
      },
      {
        "input_line": 20,
        "text": "from typing import TYPE_CHECKING, Any"
      },
      {
        "input_line": 22,
        "text": "from scrapy.spidermiddlewares.base import BaseSpiderMiddleware"
      },
      {
        "input_line": 23,
        "text": "from scrapy.utils.decorators import _warn_spider_arg"
      },
      {
        "input_line": 25,
        "text": "if TYPE_CHECKING:"
      },
      {
        "input_line": 26,
        "text": "    from collections.abc import AsyncIterator, Iterable"
      },
      {
        "input_line": 28,
        "text": "# typing.Self requires Python 3.11"
      },
      {
        "input_line": 29,
        "text": "    from typing_extensions import Self"
      },
      {
        "input_line": 31,
        "text": "from scrapy import Spider"
      },
      {
        "input_line": 32,
        "text": "    from scrapy.crawler import Crawler"
      },
      {
        "input_line": 33,
        "text": "    from scrapy.http import Request, Response"
      },
      {
        "input_line": 34,
        "text": "    from scrapy.statscollectors import StatsCollector"
      },
      {
        "input_line": 36,
        "text": "logger = logging.getLogger(__name__)"
      },
      {
        "input_line": 38,
        "text": "[docs]"
      },
      {
        "input_line": 39,
        "text": "class DepthMiddleware(BaseSpiderMiddleware):"
      },
      {
        "input_line": 40,
        "text": "    crawler: Crawler"
      },
      {
        "input_line": 42,
        "text": "def __init__(  # pylint: disable=super-init-not-called"
      },
      {
        "input_line": 43,
        "text": "        self,"
      },
      {
        "input_line": 44,
        "text": "        maxdepth: int,"
      },
      {
        "input_line": 45,
        "text": "        stats: StatsCollector,"
      },
      {
        "input_line": 46,
        "text": "        verbose_stats: bool = False,"
      },
      {
        "input_line": 47,
        "text": "        prio: int = 1,"
      },
      {
        "input_line": 48,
        "text": "    ):"
      },
      {
        "input_line": 49,
        "text": "        self.maxdepth = maxdepth"
      },
      {
        "input_line": 50,
        "text": "        self.stats = stats"
      },
      {
        "input_line": 51,
        "text": "        self.verbose_stats = verbose_stats"
      },
      {
        "input_line": 52,
        "text": "        self.prio = prio"
      },
      {
        "input_line": 65,
        "text": "@_warn_spider_arg"
      },
      {
        "input_line": 66,
        "text": "    def process_spider_output("
      },
      {
        "input_line": 67,
        "text": "        self, response: Response, result: Iterable[Any], spider: Spider | None = None"
      },
      {
        "input_line": 68,
        "text": "    ) -> Iterable[Any]:"
      },
      {
        "input_line": 69,
        "text": "        self._init_depth(response)"
      },
      {
        "input_line": 70,
        "text": "        yield from super().process_spider_output(response, result)"
      },
      {
        "input_line": 83,
        "text": "def _init_depth(self, response: Response) -> None:"
      },
      {
        "input_line": 84,
        "text": "        # base case (depth=0)"
      },
      {
        "input_line": 85,
        "text": "        if \"depth\" not in response.meta:"
      },
      {
        "input_line": 86,
        "text": "            response.meta[\"depth\"] = 0"
      },
      {
        "input_line": 87,
        "text": "            if self.verbose_stats:"
      },
      {
        "input_line": 88,
        "text": "                self.stats.inc_value(\"request_depth_count/0\")"
      }
