      {
        "input_line": 134,
        "text": "which override the global default settings."
      },
      {
        "input_line": 136,
        "text": "Those command-specific default settings are specified in the"
      },
      {
        "input_line": 137,
        "text": "`default_settings` attribute of each command class."
      }
