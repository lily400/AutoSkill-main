  {
    "http": 13,
    "window_ordinal": 12,
    "window_id": "2cfe0e4c-4d86-5f0e-ac41-1ed7ccb262d8",
    "blocks": [
      {
        "text": "Google Cloud Storage (GCS)\nThe feeds are stored on [Google Cloud Storage](https://cloud.google.com/storage/).",
        "text_sha256": "0ee90ed4227e3360950bce96a38d8a3fa62edf35a95d3875670620e60672c190",
        "source_candidates": [
          {
            "start": 6527,
            "end": 6637,
            "line_start": 176,
            "line_end": 178
          }
        ]
      },
      {
        "text": "- URI scheme: `gs`\n- Example URIs:\n  - `gs://mybucket/path/to/export.csv`\n- Required external libraries: [google-cloud-storage](https://cloud.google.com/storage/docs/reference/libraries#client-libraries-install-python).",
        "text_sha256": "854e73d5e5c9ee676fd449ad9b6b025eedd965cebaafc59d611068218771fc68",
        "source_candidates": [
          {
            "start": 6639,
            "end": 6858,
            "line_start": 180,
            "line_end": 183
          }
        ]
      },
      {
        "text": "For more information about authentication, please refer to [Google Cloud documentation](https://cloud.google.com/docs/authentication).",
        "text_sha256": "04da92276b0c269b5780260ecef4a8c4469b678449be0f73ea106d5b5b24c772",
        "source_candidates": [
          {
            "start": 6860,
            "end": 6994,
            "line_start": 185,
            "line_end": 185
          }
        ]
      }
    ]
  },
  {
    "http": 14,
    "window_ordinal": 13,
    "window_id": "61921cb3-3deb-50e9-aa01-f9fa12a11aae",
    "blocks": [
      {
        "text": "You can set a *Project ID* and *Access Control List (ACL)* through the following settings:",
        "text_sha256": "b9bcaf13b433a866b28377bb89f8075e53d3ae4f80d24d5eccd04f98859e538e",
        "source_candidates": [
          {
            "start": 6996,
            "end": 7086,
