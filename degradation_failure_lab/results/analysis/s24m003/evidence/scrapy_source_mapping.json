            "start": 23451,
            "end": 23466,
            "line_start": 643,
            "line_end": 643
          }
        ]
      },
      {
        "text": "- **file** – file-like object having at least the write, tell and close methods implemented\n- **feed_options** ([`dict`](https://docs.python.org/3/library/stdtypes.html#dict)) – feed-specific options",
        "text_sha256": "03eadf3d726bf870964a49efcacf8eedda9b31c3dbd5f54963f73f666d7a3fc5",
