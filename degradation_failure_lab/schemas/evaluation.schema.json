{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^case[0-9]{3,}_[a-z0-9_]+$"
    },
    "condition_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "enum": [
        "manual",
        "automatic"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "judgment_scope": {
            "enum": [
              "rule_preservation",
              "generated_addition"
            ]
          },
          "status": {
            "enum": [
              "unreviewed",
              "correct",
              "incorrect",
              "uncertain"
            ]
          },
          "source_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minItems": 1,
                  "uniqueItems": false
                }
              },
              "required": [
                "source_id",
                "lines"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": false
          },
          "skill_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "trace_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "stage": {
                  "enum": [
                    "window",
                    "support",
                    "draft",
                    "spec",
                    "skill"
                  ]
                },
                "entity_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "stage",
                "entity_id"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": false
          },
          "generated_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "skill_id": {
                  "type": "string",
                  "minLength": 1
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minItems": 1,
                  "uniqueItems": false
                }
              },
              "required": [
                "skill_id",
                "lines"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": false
          },
          "error_types": {
            "type": "array",
            "items": {
              "enum": [
                "condition_error",
                "exception_omission",
                "parameter_mismatch",
                "unsupported_addition",
                "rule_omission",
                "template_residue"
              ]
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "record_id",
          "rule_id",
          "judgment_scope",
          "status",
          "source_evidence",
          "skill_ids",
          "trace_refs",
          "generated_evidence",
          "error_types",
          "notes"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    }
  },
  "required": [
    "schema_version",
    "evaluation_id",
    "case_id",
    "condition_id",
    "run_id",
    "created_at",
    "method",
    "reviewer",
    "provenance",
    "records"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evaluation"
}
