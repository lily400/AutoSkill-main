{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^case[0-9]{3,}_[a-z0-9_]+$"
    },
    "condition_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "source_sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "input_id",
          "source_id",
          "source_sha256",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "condition_id",
    "inputs"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inputs"
}
