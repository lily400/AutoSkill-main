{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^case[0-9]{3,}_[a-z0-9_]+$"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "generation_config": {
      "type": "string",
      "minLength": 1
    },
    "pipeline_overrides": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "domain_type": {
          "type": "string",
          "minLength": 1
        },
        "family_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "dataset_id",
    "title",
    "source_ids",
    "generation_config",
    "pipeline_overrides"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "case"
}
